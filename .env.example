# ===================================================
# CONFIGURACIÓN DEL MICROSERVICIO BLEDOM LED
# ===================================================

# Token secreto para autenticar peticiones en el header 'x-api-key'
API_TOKEN=bledom_super_secret_token_12345

# Dirección IP y puerto de escucha (0.0.0.0 permite acceso desde la red local WiFi / iPhone)
HOST=0.0.0.0
PORT=8085

# Filtro de nombre para descubrir el dispositivo Bluetooth Low Energy
DEVICE_NAME_FILTER=BLEDOM

# Dirección MAC o BluetoothAddress del controlador (Opcional).
# Si se deja vacío, el servicio escaneará automáticamente y guardará en memoria la dirección encontrada.
# Ejemplo: DEVICE_MAC=BE:89:E0:12:34:56
DEVICE_MAC=

# Tiempo límite en segundos para escaneo y conexión BLE
BLE_TIMEOUT=8.0

# UUID de la característica GATT estándar de BLEDOM (Lotus Lantern / duoCo Strip)
GATT_CHARACTERISTIC_UUID=0000fff3-0000-1000-8000-00805f9b34fb

# Nivel de registro de logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
